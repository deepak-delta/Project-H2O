# Postgres (Neon). Pooled URL for runtime, direct URL for migrations.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Separate database/branch used by integration tests (it is wiped between suites!)
TEST_DATABASE_URL="postgresql://postgres@localhost:54329/wd_test"

# Shown in the Face ID / fingerprint prompt. The relying party ID is derived from the domain.
RP_NAME="Water Delivery"
# Secret mixed into PIN hashes. Generate with: openssl rand -base64 32 (required in production)
PIN_PEPPER="dev-only-pepper-change-me"

# Set to "production" on Vercel
NODE_ENV="development"

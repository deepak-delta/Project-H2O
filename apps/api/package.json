{
  "name": "@wd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "admin:assisted-reset": "tsx --env-file-if-exists=../../.env scripts/assisted-reset.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "^14.0.3",
    "@wd/shared": "*",
    "fastify": "^5.12.5",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}

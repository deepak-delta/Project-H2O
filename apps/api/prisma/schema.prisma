// Water Delivery — domain model.
//
// Invariants (see CLAUDE.md):
//  * Money is NUMERIC(12,2); never floats.
//  * Store balances are SUM(LedgerEntry.amount); positive = store owes the supplier.
//  * Stock and per-store can balances are SUM(InventoryMovement.*Delta). Never edited in place.
//  * Financial rows are never deleted; corrections are REVERSAL rows.
//  * Every business row carries supplierId and every query is scoped by it.
//  * Mutations that may be retried carry a client-generated clientId (idempotency key).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What kind of client this is. OTHER uses the owner's own wording (categoryOther).
enum ClientCategory {
  STORE
  HOME
  INDIVIDUAL
  OTHER
}

enum Role {
  SUPPLIER
  STORE
  /// Delivery staff added by the owner: records today's work, sees only their own day.
  STAFF
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  CANCELLED
}

enum OrderSource {
  SUPPLIER
  STORE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum LedgerType {
  SALE
  PAYMENT
  CREDIT_ADJUSTMENT
  REFUND
  DISCOUNT
  OPENING_BALANCE
  REVERSAL
}

enum MovementType {
  OPENING
  PURCHASE
  REFILL
  DELIVERY
  RETURN
  DAMAGE
  LOSS
  ADJUSTMENT
  REVERSAL
}

enum CashFlowType {
  INCOME
  EXPENSE
}

enum CashFlowCategory {
  WATER_SALE
  DEPOSIT
  CREDIT_RECOVERY
  OTHER_INCOME
  FUEL
  WATER_PURCHASE
  VEHICLE
  SALARY
  MAINTENANCE
  ELECTRICITY
  MISC
}

enum ChallengePurpose {
  REGISTER
  LOGIN
}

// ─── Business & identity ──────────────────────────────────────────────────────

model Supplier {
  id              String   @id @default(cuid())
  businessName    String
  ownerName       String
  phone           String
  email           String?
  address         String?
  currency        String   @default("INR") @db.VarChar(3)
  timezone        String   @default("Asia/Kolkata")
  nextOrderNumber Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users       User[]
  stores      Store[]
  products    Product[]
  storePrices StorePrice[]
  orders      Order[]
  deliveries  Delivery[]
  movements   InventoryMovement[]
  ledger      LedgerEntry[]
  payments    Payment[]
  cashFlow    CashFlowEntry[]
  auditLogs   AuditLog[]
}

model User {
  id                String    @id @default(cuid())
  supplierId        String
  storeId           String?   @unique
  role              Role
  name              String
  phone             String    @unique
  pinHash           String
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  active            Boolean   @default(true)
  /// Deleted staff: kept (their name stays on the work they recorded) but hidden and unusable.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplier          Supplier             @relation(fields: [supplierId], references: [id])
  store             Store?               @relation(fields: [storeId], references: [id])
  sessions          Session[]
  credentials       WebAuthnCredential[]
  pushSubscriptions PushSubscription[]
  nativePushTokens  NativePushToken[]
  totp              TotpFactor?
  recoveryCodes     RecoveryCode[]
  assistedCodes     AssistedResetCode[]
  pinResets         PinResetSession[]
  authEvents        AuthEvent[]

  storesCreated    Store[]             @relation("StoreCreatedBy")
  productsCreated  Product[]           @relation("ProductCreatedBy")
  ordersCreated    Order[]             @relation("OrderCreatedBy")
  ordersAssigned   Order[]             @relation("OrderAssignedTo")
  deliveriesMade   Delivery[]          @relation("DeliveryBy")
  movementsCreated InventoryMovement[] @relation("MovementCreatedBy")
  ledgerCreated    LedgerEntry[]       @relation("LedgerCreatedBy")
  paymentsCreated  Payment[]           @relation("PaymentCreatedBy")
  paymentsReversed Payment[]           @relation("PaymentReversedBy")
  cashFlowCreated  CashFlowEntry[]     @relation("CashFlowCreatedBy")
  auditLogs        AuditLog[]

  @@index([supplierId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceName   String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One per phone/browser that turned on notifications. Removed when the push service
/// reports it gone (410/404), on logout from that device, or when the user's access ends.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A phone running the native (Android) app, reached through Firebase Cloud Messaging.
model NativePushToken {
  id         String         @id @default(cuid())
  userId     String
  platform   NativePlatform
  token      String         @unique
  appVersion String?
  createdAt  DateTime       @default(now())
  lastUsedAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NativePlatform {
  ANDROID
  IOS
}

model AuthChallenge {
  id        String           @id @default(cuid())
  challenge String           @unique
  userId    String?
  purpose   ChallengePurpose
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  phone     String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([phone, createdAt])
}

// ─── PIN recovery (authenticator app) ────────────────────────────────────────

/// A user's authenticator-app (TOTP) factor for PIN recovery. Secrets are AES-256-GCM encrypted
/// with a server key and bound to the user; they never leave the server after setup.
model TotpFactor {
  userId                String    @id
  /// Active secret (null until the first setup is verified).
  secretEnc             String?
  enabledAt             DateTime?
  /// Highest 30-second time step already accepted: a code can't be used twice.
  lastUsedStep          Int?
  /// A secret being set up (or replacing the active one) until a code from it is verified.
  pendingSecretEnc      String?
  pendingExpiresAt      DateTime?
  pendingFailedAttempts Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One-time recovery codes, stored only as keyed hashes. Shown to the user once.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
}

/// One-time reset code issued by an operator after verifying the person's identity out of
/// band (for an owner who lost both the authenticator and the recovery codes).
model AssistedResetCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  issuedBy  String
  evidence  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
}

/// One "Forgot PIN" attempt. Bound to an HttpOnly cookie (only its hash is stored), short-lived
/// and single-use. userId is null when the phone matched no account (the answer looks the same).
model PinResetSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  phone          String
  userId         String?
  ip             String
  method         String?
  failedAttempts Int       @default(0)
  verifiedAt     DateTime?
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Security audit trail for logins-adjacent events (recovery setup, resets, failed attempts,
/// recovery-code use). Never holds PINs, secrets, codes or tokens. Also used for rate limits.
model AuthEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  phone     String?
  ip        String?
  method    String?
  detail    Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, type, createdAt])
  @@index([ip, type, createdAt])
  @@index([userId, createdAt])
}

// ─── Customers & catalogue ────────────────────────────────────────────────────

model Store {
  id            String         @id @default(cuid())
  supplierId    String
  name          String
  category      ClientCategory @default(STORE)
  /// The owner's own label when category is OTHER (e.g. "Office", "Hostel").
  categoryOther String?
  ownerName     String?
  phone         String?
  address       String?
  latitude      Decimal?       @db.Decimal(9, 6)
  longitude     Decimal?       @db.Decimal(9, 6)
  creditLimit   Decimal?       @db.Decimal(12, 2)
  status        StoreStatus    @default(ACTIVE)
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  createdBy  User                @relation("StoreCreatedBy", fields: [createdById], references: [id])
  loginUser  User?
  prices     StorePrice[]
  totals     ClientTotals?
  canTotals  ClientCans[]
  orders     Order[]
  deliveries Delivery[]
  movements  InventoryMovement[]
  ledger     LedgerEntry[]
  payments   Payment[]

  @@index([supplierId, status, name])
  @@index([supplierId, phone])
}

model Product {
  id             String   @id @default(cuid())
  supplierId     String
  name           String
  capacityLiters Decimal? @db.Decimal(8, 2)
  depositAmount  Decimal  @default(0) @db.Decimal(12, 2)
  /// Reusable containers (20L cans) are tracked with customers; bottled crates are not.
  isReturnable   Boolean  @default(true)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  createdBy     User                @relation("ProductCreatedBy", fields: [createdById], references: [id])
  orderItems    OrderItem[]
  deliveryItems DeliveryItem[]
  movements     InventoryMovement[]
  storePrices   StorePrice[]
  stock         ProductStock?
  clientCans    ClientCans[]

  @@index([supplierId, active])
}

/// What a store pays for a product. Each store negotiates its own price; there is no list price.
/// Past orders keep their own unit prices, so changing this only affects future sales.
model StorePrice {
  id         String   @id @default(cuid())
  supplierId String
  storeId    String
  productId  String
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@index([supplierId, productId, updatedAt])
}

// ─── Inventory (stock + can ledger in one table) ──────────────────────────────

model InventoryMovement {
  id                 String       @id @default(cuid())
  supplierId         String
  productId          String
  type               MovementType
  filledDelta        Int          @default(0)
  emptyDelta         Int          @default(0)
  withCustomersDelta Int          @default(0)
  damagedDelta       Int          @default(0)
  storeId            String?
  orderId            String?
  deliveryId         String?
  reversesId         String?      @unique
  reason             String?
  clientId           String?
  occurredAt         DateTime     @default(now())
  createdById        String
  createdAt          DateTime     @default(now())

  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  product    Product            @relation(fields: [productId], references: [id])
  store      Store?             @relation(fields: [storeId], references: [id])
  order      Order?             @relation(fields: [orderId], references: [id])
  delivery   Delivery?          @relation(fields: [deliveryId], references: [id])
  reverses   InventoryMovement? @relation("MovementReversal", fields: [reversesId], references: [id])
  reversedBy InventoryMovement? @relation("MovementReversal")
  createdBy  User               @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@unique([supplierId, clientId])
  @@index([supplierId, productId])
  @@index([supplierId, storeId, occurredAt])
  @@index([supplierId, occurredAt])
  @@index([supplierId, createdAt])
  @@index([deliveryId])
}

// ─── Orders & deliveries ──────────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  supplierId   String
  storeId      String
  orderNumber  Int
  status       OrderStatus @default(PENDING)
  source       OrderSource @default(SUPPLIER)
  orderDate    DateTime    @default(now())
  deliveryDate DateTime?
  subtotal     Decimal     @db.Decimal(12, 2)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  total        Decimal     @db.Decimal(12, 2)
  notes        String?
  clientId     String?
  cancelledAt  DateTime?
  cancelReason String?
  createdById  String
  /// Staff member the owner gave this order to; they deliver it. Null = owner handles it.
  assignedToId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  store      Store               @relation(fields: [storeId], references: [id])
  createdBy  User                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  assignedTo User?               @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  items      OrderItem[]
  deliveries Delivery[]
  movements  InventoryMovement[]
  ledger     LedgerEntry[]
  payments   Payment[]

  @@unique([supplierId, orderNumber])
  @@unique([supplierId, clientId])
  @@index([supplierId, status, deliveryDate])
  @@index([supplierId, storeId, orderDate])
  @@index([supplierId, orderDate])
  @@index([supplierId, updatedAt])
  @@index([supplierId, assignedToId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Delivery {
  id            String   @id @default(cuid())
  supplierId    String
  orderId       String
  storeId       String
  deliveredById String
  deliveredAt   DateTime @default(now())
  notes         String?
  /// Set when the delivery pushed filled stock below zero (accepted, but needs review).
  stockWarning  Boolean  @default(false)
  clientId      String?
  createdAt     DateTime @default(now())

  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  order       Order               @relation(fields: [orderId], references: [id])
  store       Store               @relation(fields: [storeId], references: [id])
  deliveredBy User                @relation("DeliveryBy", fields: [deliveredById], references: [id])
  items       DeliveryItem[]
  movements   InventoryMovement[]

  @@unique([supplierId, clientId])
  @@index([supplierId, deliveredAt])
  @@index([supplierId, storeId, deliveredAt])
  @@index([orderId])
}

model DeliveryItem {
  id             String  @id @default(cuid())
  deliveryId     String
  productId      String
  deliveredQty   Int
  emptyCollected Int     @default(0)
  damagedQty     Int     @default(0)
  /// What the store was charged for the damaged cans on this line (damagedQty × price per can).
  damageCharge   Decimal @default(0) @db.Decimal(12, 2)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([deliveryId, productId])
}

// ─── Money ────────────────────────────────────────────────────────────────────

model LedgerEntry {
  id          String     @id @default(cuid())
  supplierId  String
  storeId     String
  type        LedgerType
  /// Signed. Positive increases what the store owes; negative reduces it.
  amount      Decimal    @db.Decimal(12, 2)
  orderId     String?
  paymentId   String?
  reversesId  String?    @unique
  note        String?
  occurredAt  DateTime   @default(now())
  createdById String
  createdAt   DateTime   @default(now())

  supplier   Supplier     @relation(fields: [supplierId], references: [id])
  store      Store        @relation(fields: [storeId], references: [id])
  order      Order?       @relation(fields: [orderId], references: [id])
  payment    Payment?     @relation(fields: [paymentId], references: [id])
  reverses   LedgerEntry? @relation("LedgerReversal", fields: [reversesId], references: [id])
  reversedBy LedgerEntry? @relation("LedgerReversal")
  createdBy  User         @relation("LedgerCreatedBy", fields: [createdById], references: [id])

  @@index([supplierId, storeId, occurredAt])
  @@index([supplierId, occurredAt])
  /// Newest entry first: the owner's "anything new?" check.
  @@index([supplierId, createdAt])
  @@index([orderId])
  @@index([paymentId])
}

model Payment {
  id              String        @id @default(cuid())
  supplierId      String
  storeId         String
  orderId         String?
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNumber String?
  paymentDate     DateTime      @default(now())
  notes           String?
  clientId        String?
  reversedAt      DateTime?
  reversedById    String?
  reversalReason  String?
  createdById     String
  createdAt       DateTime      @default(now())

  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  store      Store           @relation(fields: [storeId], references: [id])
  order      Order?          @relation(fields: [orderId], references: [id])
  createdBy  User            @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  reversedBy User?           @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  ledger     LedgerEntry[]
  cashFlow   CashFlowEntry[]

  @@unique([supplierId, clientId])
  @@index([supplierId, storeId, paymentDate])
  @@index([supplierId, paymentDate])
  @@index([orderId])
}

model CashFlowEntry {
  id          String           @id @default(cuid())
  supplierId  String
  type        CashFlowType
  category    CashFlowCategory
  /// Signed within its type: a reversal of income is a negative INCOME row.
  amount      Decimal          @db.Decimal(12, 2)
  date        DateTime         @default(now())
  method      PaymentMethod
  description String?
  reference   String?
  paymentId   String?
  reversesId  String?          @unique
  clientId    String?
  createdById String
  createdAt   DateTime         @default(now())

  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  payment    Payment?       @relation(fields: [paymentId], references: [id])
  reverses   CashFlowEntry? @relation("CashFlowReversal", fields: [reversesId], references: [id])
  reversedBy CashFlowEntry? @relation("CashFlowReversal")
  createdBy  User           @relation("CashFlowCreatedBy", fields: [createdById], references: [id])

  @@unique([supplierId, clientId])
  @@index([supplierId, date])
  @@index([supplierId, createdAt])
  @@index([supplierId, type, category, date])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  supplierId String
  actorId    String
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  actor    User     @relation(fields: [actorId], references: [id])

  @@index([supplierId, entity, entityId])
  @@index([supplierId, createdAt])
}

/// Running stock per product, kept by a database trigger on every InventoryMovement insert
/// (in the same transaction). Always equals the sum of the movements; never written by the app.
model ProductStock {
  productId     String @id
  supplierId    String
  filled        Int    @default(0)
  empty         Int    @default(0)
  withCustomers Int    @default(0)
  damaged       Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

/// Running totals per client, kept by database triggers on LedgerEntry and InventoryMovement
/// inserts. balance = sum of the client's ledger; cans = sum of cans moved to/from the client.
model ClientTotals {
  storeId        String    @id
  supplierId     String
  balance        Decimal   @default(0) @db.Decimal(14, 2)
  cans           Int       @default(0)
  lastDeliveryAt DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([supplierId, balance])
}

/// Cans of each product at each client, kept by a trigger like ClientTotals.
model ClientCans {
  storeId    String
  productId  String
  supplierId String
  cans       Int    @default(0)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([storeId, productId])
  @@index([supplierId, productId])
}

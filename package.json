{
  "name": "waterdelivery",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @wd/web",
    "build:vercel": "node scripts/vercel-build.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @wd/api",
    "db:seed": "npm run db:seed -w @wd/api",
    "e2e": "playwright test",
    "docs:guide": "playwright test -c playwright.docs.config.ts",
    "docs:test-plan": "node docs/testing/build-test-plan.mjs",
    "mobile:sync": "npm run sync -w @wd/mobile",
    "mobile:android": "npm run open -w @wd/mobile",
    "mobile:apk": "npm run apk -w @wd/mobile"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
